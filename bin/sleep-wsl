#!/usr/bin/env bash
#
# sleep-wsl - put the Windows host into S3 sleep over WSL SSH.
#
# The WSL distribution is assumed to be reachable through Tailscale/MagicDNS
# as "wsl". Override it with --host or SLEEP_WSL_SSH_HOST. Every other option
# of sleep-desktop applies.
#
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export SLEEP_DESKTOP_COMMAND_NAME="sleep-wsl"
export SLEEP_DESKTOP_SSH_HOST="${SLEEP_WSL_SSH_HOST:-wsl}"
export SLEEP_DESKTOP_SSH_USER="${SLEEP_WSL_SSH_USER:-${SLEEP_DESKTOP_SSH_USER:-}}"
export SLEEP_DESKTOP_SSH_PORT="${SLEEP_WSL_SSH_PORT:-${SLEEP_DESKTOP_SSH_PORT:-}}"
export SLEEP_DESKTOP_STAMP_PATH="${SLEEP_WSL_STAMP_PATH:-.cache/dotfiles-wsl-sleep/slept-at}"

exec "${script_dir}/sleep-desktop" --mode windows --target-name "Windows host" "$@"

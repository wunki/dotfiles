# vim: filetype=conf

# shell extras
shell-integration-features = sudo, ssh-terminfo

# fonts
font-family = Comic Code Ligatures
font-size = 11
font-style-bold = Medium
font-feature = ss01, ss02
adjust-cell-height = 28%

# colors
window-colorspace = display-p3
selection-foreground = cell-background
selection-background = cell-foreground
theme = cendre

# padding
window-padding-balance = true
window-padding-x = 7
window-padding-y = 7

# an empty bar, that's all I want
macos-titlebar-proxy-icon = hidden
macos-titlebar-style = tabs

# options
window-save-state = always
mouse-hide-while-typing = true
confirm-close-surface = false

# clipboard
copy-on-select = clipboard
clipboard-read = allow

# mac
macos-option-as-alt = true
bell-features = no-title,no-attention

# updates
auto-update = off
keybind = cmd+shift+u=check_for_updates

# split settings
unfocused-split-opacity = 0.75

# shift-enter in Claude
keybind = shift+enter=text:\n

# copy hovered hyperlink target (for file:// links from eza)
keybind = cmd+shift+y=copy_url_to_clipboard

#!/usr/bin/env bash
#
# wake-win - wake the Windows host and wait for its native OpenSSH server.
#
# wake-wsl wakes the same machine but waits for WSL, which doesn't start until
# something launches it. Windows has no POSIX shell, so this skips the sleep
# timestamp that the Linux and WSL targets report.
#
# The resolved Tailscale IP bypasses ~/.ssh/config, so the Windows account
# name is passed here. Override it with WAKE_WIN_TARGET_SSH_USER.
#
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export WAKE_DESKTOP_COMMAND_NAME="wake-win"

exec "${script_dir}/wake-desktop" \
  --target-host "${WAKE_WIN_TARGET_SSH_HOST:-desktop-win}" \
  --target-user "${WAKE_WIN_TARGET_SSH_USER:-Petar Radosevic}" \
  --target-name "Windows" \
  --no-stamp \
  "$@"

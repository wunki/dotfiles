# Tag every hiddev node for the Apple Studio Display (05ac:1114).
KERNEL=="hiddev*", SUBSYSTEM=="usbmisc", ATTRS{idVendor}=="05ac", ATTRS{idProduct}=="1114", ENV{ASD_DISPLAY}="1"
# Interface 07 controls brightness. Grant user access through a stable symlink.
ENV{ASD_DISPLAY}=="1", ATTRS{bInterfaceNumber}=="07", GROUP="users", MODE="0660", SYMLINK+="apple-studio-display"
# Hold the speaker amplifier at full scale. WirePlumber uses a soft mixer for
# this card, so PipeWire never raises a level saved low by alsactl. RUN fires
# after every rule is processed, so it lands after 90-alsa-restore.rules.
ACTION=="add", SUBSYSTEM=="sound", KERNEL=="controlC*", ATTRS{idVendor}=="05ac", ATTRS{idProduct}=="1114", RUN+="/usr/bin/amixer -q -c %n sset PCM 100%% unmute"

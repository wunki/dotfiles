# vim: filetype=conf

# Shell integration
shell-integration-features = sudo, ssh-terminfo

# Font
font-family = Berkeley Mono
font-size = 10
# font-style-bold = Medium
font-feature = ss02, ss04
adjust-cell-height = 12%

# Cursor
cursor-style = bar
adjust-cursor-thickness = 3

# Colors
window-colorspace = display-p3
selection-foreground = cell-background
selection-background = cell-foreground
theme = cendre

# Padding
window-padding-balance = true
window-padding-x = 7
window-padding-y = 7

# Keep the title bar empty.
macos-titlebar-proxy-icon = hidden
macos-titlebar-style = tabs

# Window
window-save-state = always
mouse-hide-while-typing = true
confirm-close-surface = false

# Clipboard
copy-on-select = clipboard
clipboard-read = allow

# macOS
macos-option-as-alt = true
bell-features = no-title,no-attention

# Updates
auto-update = off
keybind = cmd+shift+u=check_for_updates

# Splits
unfocused-split-opacity = 0.75

# Insert a newline in Claude Code.
keybind = shift+enter=text:\n

# Copy hovered file:// links from eza.
keybind = cmd+shift+y=copy_url_to_clipboard

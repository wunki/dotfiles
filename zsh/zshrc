#!/bin/zsh -f

# Keep Zsh minimal and quick to start.

# Pin Emacs bindings instead of inheriting the editor's mode.
bindkey -e

# History
HISTFILE=$HOME/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt SHARE_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_SPACE

# Extend the path
typeset -U PATH path

# Environment
export LANG='en_US.UTF-8'
export LC_ALL='en_US.UTF-8'
export XDG_DATA_HOME=$HOME/.local/share
export GOPATH="$HOME/Code/go"
os_name="$(uname)"

# macOS configuration
if [[ "$os_name" == "Darwin" ]]; then
  source ~/.zshrc.mac
else
  export EDITOR="nvim"
fi

# Path configuration
path+=(
  "$HOME/.local/bin"
  "$HOME/.cargo/bin"        # Rust
  "$HOME/.zvm/self"         # Zig
  "$HOME/.zvm/bin"
  "$HOME/.local/share/pnpm" # pnpm
  "$HOME/.opencode/bin"     # opencode
  "$GOPATH/bin"             # Go
)
[[ "$(uname)" != "Darwin" ]] && path+=("/opt/nvim/bin")  # Neovim (non-Mac)
export PATH

# Erlang
export KERL_CONFIGURE_OPTIONS="--disable-debug --without-javac"
# Elixir: partition os_deps compile work by CPU cores / 2
if [[ "$(uname)" == "Darwin" ]]; then
  export MIX_OS_DEPS_COMPILE_PARTITION_COUNT=$(($(sysctl -n hw.physicalcpu) / 2))
else
  export MIX_OS_DEPS_COMPILE_PARTITION_COUNT=$(($(nproc) / 2))
fi

# pnpm
export PNPM_HOME="$HOME/.local/share/pnpm"
alias pp='pnpm'
alias ppx='pnpx'
alias oc='opencode'

# Shortcuts
alias e='nvim'
alias tt='tmux attach || tmux new-session -s main'
alias ssb="ssh -t bytebottom 'tmux attach || tmux new-session -s main'"
lisp() {
  command sbcl "$@" \
    --eval '(ql:quickload "linedit" :silent t)' \
    --eval '(linedit:install-repl :wrap-current t :eof-quits t)'
}

if (( $+commands[bat] ))
then
  alias cat='bat'
fi

# Git TUI
if (( $+commands[gitu] ))
then
  alias gu='gitu'
fi

# File listing
if (( $+commands[eza] ))
then
  source "$HOME/.config/eza/cendre.sh"
  alias ls='eza'                              # ls
  alias l='eza -lbF --git'                    # list, size, type, git
  alias ll='eza -lbGF --git'                  # long list
fi

if (( $+commands[fzf] ))
then
  source "$HOME/.config/fzf/cendre.sh"
fi

# Git shortcuts
alias gho='gh browse'
alias gc='git commit'
alias gs='git status --ignore-submodules=dirty'
alias gp='git push origin HEAD'
alias gpf='git push --force-with-lease origin HEAD'
alias gf='git pull origin HEAD'

# Mise version manager
if (( $+commands[mise] ))
then
  eval "$(~/.local/bin/mise activate zsh)"
fi

# Load per-directory environment variables.
if (( $+commands[direnv] ))
then
  eval "$(direnv hook zsh)"
fi

# Directory jumping
if (( $+commands[zoxide] ))
then
  eval "$(zoxide init zsh)"
fi

# Fish-style autosuggestions
[[ -d "$HOME/.zsh/zsh-autosuggestions" ]] && source ~/.zsh/zsh-autosuggestions/zsh-autosuggestions.zsh

# Fish-style syntax highlighting
[[ -d "$HOME/.zsh/fast-syntax-highlighting" ]] && source ~/.zsh/fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh

# Automatically close, delete and skip matching delimiting pairs.
if [[ -d "$HOME/.zsh/zsh-autopair" ]]; then
  source ~/.zsh/zsh-autopair/autopair.zsh
  autopair-init
fi

# Completion settings (must be before compinit)
zstyle ':completion:*' menu select
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path ~/.zsh/cache

# Enable autocompletion (rebuild once per day, skip security audit with -u)
autoload -Uz compinit
if [[ -n ~/.zcompdump(#qN.mh+24) ]]; then
  compinit -u
else
  compinit -Cu
fi

# TRAMP sets TERM=dumb and needs a plain prompt for its connection handshake.
# Keep Pure for interactive terminal sessions.
if [[ $TERM == dumb ]]; then
  PROMPT='$ '
else
  fpath+=($HOME/.zsh/pure)
  PURE_PROMPT_SYMBOL='λ'
  zstyle ':prompt:pure:prompt:success' color blue
  zstyle ':prompt:pure:prompt:error' color red

  autoload -U promptinit; promptinit
  prompt pure
fi

# Emacs Eat integration
[ -n "$EAT_SHELL_INTEGRATION_DIR" ] && \
  source "$EAT_SHELL_INTEGRATION_DIR/zsh"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
[ -s "/Users/petar/.bun/_bun" ] && source "/Users/petar/.bun/_bun"

# Vite+ bin (https://viteplus.dev)
. "$HOME/.vite-plus/env"

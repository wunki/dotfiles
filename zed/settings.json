{
  "buffer_font_family": "Monaspace Argon",
  "buffer_font_weight": 300,
  "buffer_font_features": {
    "calt": true,
    "ss03": true
  },
  "buffer_font_size": 11.0,
  "agent_ui_font_size": 12.0,
  "agent_buffer_font_size": 11.0,
  "context_servers": {
    "tidewave-mcp": {
      "enabled": true,
      "remote": false,
      "settings": {}
    },
    "linear": {
      "enabled": true,
      "remote": false,
      "settings": {}
    }
  },
  "ssh_connections": [
    {
      "host": "desktop",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/petar/Code/bitebottom/tonen"
          ]
        },
        {
          "paths": [
            "/home/petar/Code/bitebottom/tonen/apps/web"
          ]
        }
      ]
    }
  ],
  "diff_view_style": "split",
  "cli_default_open_behavior": "new_window",
  "outline_panel": {
    "dock": "right",
  },
  "git_panel": {
    "dock": "right",
  },
  "semantic_tokens": "combined",
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "text_rendering_mode": "platform_default",
  "agent": {
    "commit_message_instructions": "Write a concise Conventional Commit for the provided change. Format the subject as type(scope): imperative outcome. Start the description after the colon with a lowercase letter. Omit the scope when it adds no useful context. Use feat, fix, refactor, test, docs, chore, build, ci, or perf. Keep it under 72 characters with no trailing period. Use ! only for a breaking change. Describe the behavior, problem, or engineering outcome, not the files, symbols, or implementation steps. Add a short body only when it provides review context the subject cannot: the motivation, decision, or a material tradeoff. Prefer context, decision, and consequence over a tour of the code. Do not list changed files or functions, repeat the subject, add headings or bullets, or invent rationale that is not supported by the change. If the reason is unclear, omit the body rather than guess. Output only the commit message.",
    "commit_message_model": {
      "provider": "openai-subscribed",
      "model": "gpt-5.6-terra",
    },
    "tool_permissions": {
      "tools": {
        "mcp:linear:resolve_diff_thread": {
          "default": "allow"
        },
        "mcp:linear:list_documents": {
          "default": "allow"
        },
        "move_path": {
          "default": "allow"
        },
        "mcp:linear:delete_attachment": {
          "default": "allow"
        },
        "mcp:linear:list_milestones": {
          "default": "allow"
        },
        "mcp:linear:list_issue_labels": {
          "default": "allow"
        },
        "mcp:tidewave-mcp:get_docs": {
          "default": "allow"
        },
        "mcp:tidewave-mcp:get_source_location": {
          "default": "allow"
        },
        "mcp:tidewave-mcp:execute_sql_query": {
          "default": "allow"
        },
        "mcp:tidewave-mcp:get_ecto_schemas": {
          "default": "allow"
        },
        "mcp:tidewave-mcp:get_logs": {
          "default": "allow"
        },
        "mcp:tidewave-mcp:project_eval": {
          "default": "allow"
        },
        "mcp:linear:get_milestone": {
          "default": "allow"
        },
        "mcp:linear:get_diff_threads": {
          "default": "allow"
        },
        "mcp:linear:save_comment": {
          "default": "allow"
        },
        "mcp:linear:list_diffs": {
          "default": "allow"
        },
        "mcp:linear:get_diff": {
          "default": "allow"
        },
        "skill": {
          "default": "allow"
        },
        "mcp:linear:list_comments": {
          "default": "allow"
        },
        "mcp:linear:get_issue": {
          "default": "allow"
        },
        "mcp:linear:get_status_updates": {
          "default": "allow"
        },
        "mcp:linear:list_issues": {
          "default": "allow"
        },
        "mcp:linear:get_project": {
          "default": "allow"
        },
        "fetch": {
          "default": "allow"
        },
        "mcp:linear:save_issue": {
          "default": "allow"
        },
        "mcp:linear:list_issue_statuses": {
          "default": "allow"
        },
        "terminal": {
          "default": "allow",
          "always_allow": [
            {
              "pattern": "^git\\s+switch(\\s|$)"
            },
            {
              "pattern": "^git\\b"
            },
            {
              "pattern": "^printf\\s+%sn(\\s|$)"
            },
            {
              "pattern": "^test\\b"
            },
            {
              "pattern": "^echo\\s+all(\\s|$)"
            },
            {
              "pattern": "^find\\s+\\.agents/skills(\\s|$)"
            },
            {
              "pattern": "^git\\s+add(\\s|$)"
            },
            {
              "pattern": "^shasum\\b"
            },
            {
              "pattern": "^file\\s+AGENTS\\.md(\\s|$)"
            },
            {
              "pattern": "^find\\s+\\.(\\s|$)"
            }
          ]
        }
      }
    },
    "sandbox_permissions": {
      "network_hosts": [
        "zed.dev",
        "github.com",
        "linear.app",
        "developers.openai.com",
        "www.electronjs.org",
        "www.electronforge.io",
        "git-scm.com",
        "raw.githubusercontent.com",
        "mise.jdx.dev",
        "hexdocs.pm",
        "www.google.com",
        "agentclientprotocol.com",
        "svelte.dev",
        "docs.github.com",
        "www.hetzner.com",
        "agentskills.io",
        "api.github.com"
      ]
    },
    "dock": "left",
    "enable_feedback": false,
    "default_model": {
      "speed": "fast",
      "effort": "high",
      "provider": "openai-subscribed",
      "model": "gpt-5.6-sol",
      "enable_thinking": true,
    },
    "play_sound_when_agent_done": "always",
    "favorite_models": [],
    "notify_when_agent_waiting": "never",
    "model_parameters": [],
  },
  "buffer_line_height": {
    "custom": 1.7999999523162842
  },
  "colorize_brackets": true,
  "agent_servers": {
    "opencode": {
      "type": "registry",
    },
    "claude-acp": {
      "type": "registry",
    },
    "gemini": {
      "type": "registry",
    },
    "codex-acp": {
      "type": "registry",
    },
  },
  "gutter": {
    "line_numbers": false,
  },
  "auto_install_extensions": {
    "caddyfile": true,
    "clojure": true,
    "dockerfile": true,
    "elixir": true,
    "everforest": true,
    "fish": true,
    "git-firefly": true,
    "html": true,
    "log": true,
    "odin": true,
    "oxc": true,
    "scss": true,
    "sql": true,
    "svelte": true,
    "toml": true,
  },
  "collaboration_panel": {
    "dock": "right",
    "button": false,
  },
  "current_line_highlight": "line",
  "cursor_blink": true,
  "edit_predictions": {
    "provider": "zed",
    "disabled_globs": [".env", "**/journal"],
    "mode": "eager",
  },
  "file_types": {
    "CSS": ["scss"],
    "Shell Script": [".envrc", ".env"],
  },
  "git_commit_buffer_font_size": 11.0,
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "inlay_hints": {
    "enabled": false,
  },
  "languages": {
    "Elixir": {
      "language_servers": [
        "dexter",
        "!expert",
        "!elixir-ls",
        "!next-ls",
        "!lexical",
        "tailwindcss-language-server",
      ],
    },
    "EEx": {
      "language_servers": ["dexter", "!expert", "!elixir-ls", "!next-ls", "!lexical"],
    },
    "HEEx": {
      "language_servers": [
        "dexter",
        "!expert",
        "!elixir-ls",
        "!next-ls",
        "!lexical",
        "tailwindcss-language-server",
      ],
    },
    "HTML": {
      "hard_tabs": false,
      "tab_size": 2,
    },
    "JavaScript": {
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
      },
      "hard_tabs": false,
      "tab_size": 2,
    },
    "Markdown": {
      "show_edit_predictions": false,
    },
    "Svelte": {
      "hard_tabs": false,
      "tab_size": 2,
    },
    "TypeScript": {
      "hard_tabs": false,
      "tab_size": 2,
    },
  },
  "lsp": {
    "vscode-css-language-server": {
      "settings": {
        "css": {
          "validate": false,
        },
      },
    },
    "tailwindcss-language-server": {
      "settings": {
        "includeLanguages": {
          "elixir": "html",
          "heex": "html",
        },
        "experimental": {
          "classRegex": ["class=\"([^\"]*)\"", "class='([^']*)'"],
        },
      },
    },
    "dexter": {
      "initialization_options": {
        "followDelegates": true,
      },
    },
    "expert": {
      "binary": {
        "path": "/Users/petar/.local/bin/expert_darwin_arm64",
        "arguments": ["--stdio"],
      },
    },
  },
  "middle_click_paste": true,
  "preferred_line_length": 100,
  "project_panel": {
    "hide_root": false,
    "dock": "right",
  },
  "relative_line_numbers": "enabled",
  "scrollbar": {
    "show": "never",
  },
  "show_completions_on_input": true,
  "show_edit_predictions": true,
  "soft_wrap": "editor_width",
  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": false,
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "terminal": {
    "font_weight": 300.0,
    "line_height": "comfortable",
    "scrollbar": {
      "show": "auto",
    },
    "blinking": "off",
    "copy_on_select": true,
    "dock": "bottom",
    "env": {
      "TERM_PROGRAM": "zed",
    },
    "option_as_meta": true,
    "toolbar": {
      "breadcrumbs": false,
    },
  },
  "theme": {
    "mode": "dark",
    "light": "Melange Light",
    "dark": "Everforest Dark Hard (material)"
  },
  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": false,
  },
  "ui_font_family": "iA Writer Duospace",
  "ui_font_size": 12.0,
  "use_autoclose": true,
  "vertical_scroll_margin": 5,
  "vim": {
    "toggle_relative_line_numbers": true,
  },
  "vim_mode": true,
}

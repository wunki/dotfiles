#!/usr/bin/env bash
# Copy a Markdown message to the macOS clipboard so it pastes into Slack
# with its formatting intact.
#
# Slack's message box ignores Markdown typed as plain text in most cases,
# but it keeps bold, italics, links, lists, quotes and code when the
# clipboard holds HTML, the same way a paste from a browser does. So the
# clipboard gets two versions: HTML for Slack and other rich editors, and
# the Markdown source as plain text for anything that only takes text.
#
# Usage: slack-copy FILE     (or pipe the message on stdin)

set -euo pipefail

if [[ "$(uname)" != "Darwin" ]]; then
  echo "slack-copy: needs macOS (writes the clipboard through AppKit)" >&2
  exit 1
fi

if ! command -v pandoc >/dev/null; then
  echo "slack-copy: pandoc not found; install it with 'brew install pandoc'" >&2
  exit 1
fi

markdown="$(cat "${1:-/dev/stdin}")"

if [[ -z "${markdown//[[:space:]]/}" ]]; then
  echo "slack-copy: message is empty, clipboard left unchanged" >&2
  exit 1
fi

# gfm keeps single line breaks as spaces and understands fenced code and
# ~strikethrough~, which matches how the messages are written.
html="$(printf '%s' "$markdown" | pandoc --from gfm --to html --wrap none)"

# JavaScript for Automation reaches NSPasteboard directly, which pbcopy
# cannot: pbcopy only ever writes plain text.
osascript -l JavaScript - "$html" "$markdown" <<'JXA'
ObjC.import("AppKit");
function run(argv) {
  const pasteboard = $.NSPasteboard.generalPasteboard;
  pasteboard.clearContents;
  const okHtml = pasteboard.setStringForType($(argv[0]), $.NSPasteboardTypeHTML);
  const okText = pasteboard.setStringForType($(argv[1]), $.NSPasteboardTypeString);
  if (!okHtml || !okText) {
    throw new Error("NSPasteboard refused the write");
  }
}
JXA

echo "slack-copy: copied to clipboard (HTML + plain text)" >&2
